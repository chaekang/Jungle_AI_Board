NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_board?schema=public
JWT_SECRET=replace-with-local-dev-secret
JWT_EXPIRES_IN=1d
AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_ACCESS_COOKIE_MAX_AGE_MS=900000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_APP_ORIGIN=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_QUESTION_RATE_LIMIT_MAX_REQUESTS=20
RAG_QUESTION_RATE_LIMIT_WINDOW_MS=60000
