# Copy this file to .env.production on the Lightsail instance only.
# Never commit the populated .env.production file.

DOMAIN=203.0.113.10.nip.io
NEST_ENV_FILE=.env.production
WEB_PORT=127.0.0.1:8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-long-alphanumeric-password
POSTGRES_DB=agentic_board

TRUST_PROXY_HOPS=2
JWT_SECRET=replace-with-64-byte-random-secret
JWT_EXPIRES_IN=1d
AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_ACCESS_COOKIE_MAX_AGE_MS=900000
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

CORS_ORIGINS=https://203.0.113.10.nip.io
WEB_APP_ORIGIN=https://203.0.113.10.nip.io
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=https://203.0.113.10.nip.io/api/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-64-byte-random-secret

OPENAI_API_KEY=replace-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_QUESTION_RATE_LIMIT_MAX_REQUESTS=20
RAG_QUESTION_RATE_LIMIT_WINDOW_MS=60000

NEST_API_TIMEOUT_SECONDS=8
VITE_API_BASE_URL=/api
VITE_AGENT_API_BASE_URL=
