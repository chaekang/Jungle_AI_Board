# Copy to .env.aws for local production-like compose runs.
# In AWS, store these values in SSM Parameter Store or Secrets Manager instead.

NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1

# RDS PostgreSQL with pgvector enabled. Do not expose the database publicly.
DATABASE_URL=postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/agentic_board?schema=public&sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=replace-with-64-byte-random-secret
JWT_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_ACCESS_COOKIE_MAX_AGE_MS=900000

# HTTPS production cookies.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=.example.com

# Comma-separated browser origins that may send credentialed requests.
CORS_ORIGINS=https://app.example.com
WEB_APP_ORIGIN=https://app.example.com

# Google OAuth.
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-64-byte-random-secret

# OpenAI RAG.
OPENAI_API_KEY=replace-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_QUESTION_RATE_LIMIT_MAX_REQUESTS=20
RAG_QUESTION_RATE_LIMIT_WINDOW_MS=60000

# FastAPI internal service.
NEST_API_BASE_URL=http://nest-api:3000
NEST_API_TIMEOUT_SECONDS=8

# Used only by docker-compose.aws.example.yml at web build time.
PUBLIC_NEST_API_URL=https://api.example.com
PUBLIC_FASTAPI_API_URL=https://agent.example.com
